# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=hy10

# JWT Configuration - REQUIRED FOR AUTHENTICATION
# Generate a secure secret with: openssl rand -hex 64
# CRITICAL: Must be at least 64 characters long for security
JWT_SECRET=your-secure-jwt-secret-minimum-64-characters-generate-with-openssl-rand-hex-64
JWT_EXPIRES_IN=15m

# Refresh Token Configuration
REFRESH_TOKEN_SECRET=your-refresh-token-secret-minimum-64-characters
REFRESH_TOKEN_EXPIRES_IN=2d

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback

# Application
PORT=3001
NODE_ENV=development
WEB_ORIGIN=http://localhost:3000

# Email Configuration (SMTP for password reset and notifications)
# For development, you can use Mailtrap, Gmail, or other SMTP providers
# For production, use a transactional email service like SendGrid, AWS SES, or Postmark
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_SECURE=false
MAIL_USER=your-mailtrap-user
MAIL_PASSWORD=your-mailtrap-password
MAIL_FROM=noreply@hy10.app

# Gmail configuration example (requires App Password):
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_SECURE=false
# MAIL_USER=your-email@gmail.com
# MAIL_PASSWORD=your-app-password
# MAIL_FROM=noreply@hy10.app

# SendGrid configuration example:
# MAIL_HOST=smtp.sendgrid.net
# MAIL_PORT=587
# MAIL_SECURE=false
# MAIL_USER=apikey
# MAIL_PASSWORD=your-sendgrid-api-key
# MAIL_FROM=noreply@hy10.app

# Telegram Bot Configuration (add when implementing)
# TELEGRAM_BOT_TOKEN=your-bot-token
# TELEGRAM_WEBHOOK_SECRET=your-webhook-secret

# Wompi Configuration (add when implementing billing)
# WOMPI_PUBLIC_KEY=your-wompi-public-key
# WOMPI_PRIVATE_KEY=your-wompi-private-key
# WOMPI_EVENTS_SECRET=your-wompi-events-secret

# LLM Configuration (add when implementing agent)
# LLM_PROVIDER=anthropic
# LLM_API_KEY=your-llm-api-key
# LLM_MODEL_ID=claude-3-sonnet-20240229

# Speech Transcription (add when implementing voice notes)
# TRANSCRIPTION_API_KEY=your-transcription-api-key
# VOICE_NOTE_MAX_SECONDS=60

# Encryption (for bot token storage)
# MASTER_ENCRYPTION_KEY=your-master-key-here

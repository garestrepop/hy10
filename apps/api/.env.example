# Environment Configuration
NODE_ENV=development
PORT=3001

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=hy10

# Web App Origin (for CORS)
WEB_ORIGIN=http://localhost:3000

# JWT Configuration (add these when implementing auth)
# JWT_SECRET=your-jwt-secret-here
# JWT_EXPIRES_IN=15m
# REFRESH_TOKEN_SECRET=your-refresh-token-secret-here
# REFRESH_TOKEN_EXPIRES_IN=2d

# Telegram Bot Configuration (add when implementing)
# TELEGRAM_BOT_TOKEN=your-bot-token
# TELEGRAM_WEBHOOK_SECRET=your-webhook-secret

# Wompi Configuration (add when implementing billing)
# WOMPI_PUBLIC_KEY=your-wompi-public-key
# WOMPI_PRIVATE_KEY=your-wompi-private-key
# WOMPI_EVENTS_SECRET=your-wompi-events-secret

# LLM Configuration (add when implementing agent)
# LLM_PROVIDER=anthropic
# LLM_API_KEY=your-llm-api-key
# LLM_MODEL_ID=claude-3-sonnet-20240229

# Speech Transcription (add when implementing voice notes)
# TRANSCRIPTION_API_KEY=your-transcription-api-key
# VOICE_NOTE_MAX_SECONDS=60

# Encryption (for bot token storage)
# MASTER_ENCRYPTION_KEY=your-master-key-here

{
  "moduleNameMapper": {
    "^src/(.*)$": "<rootDir>/src/$1"
  },
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testRegex": ".*\\.spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "collectCoverageFrom": ["**/*.(t|j)s"],
  "coverageDirectory": "./coverage",
  "testEnvironment": "node",
  "transformIgnorePatterns": [
    "node_modules/(?!(@nestjs/jwt|@nestjs/passport|@nestjs/throttler|jsonwebtoken|passport|passport-jwt|passport-google-oauth20)/)"
  ],
  "modulePathIgnorePatterns": ["<rootDir>/dist/"]
}
